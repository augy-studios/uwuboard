<!-- uwuBoard's .msi (docs/desktop-features-spec.md §16), for Group Policy and msiexec: x64, per
     user, a MajorUpgrade so each version replaces the last, Start menu and desktop shortcuts, and
     uwu:// links. Its UpgradeCode never changes. The app can't update an .msi install itself; it
     says when there's a new version, with a link to download it.

     Built by .github/workflows/build-desktop.yml with WiX 5:
       wix build uwuboard.wxs -arch x64 -d Version=1.0.0 -d Source=<x64 Release folder> -o uwuboard-1.0.0.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="uwuBoard" Manufacturer="Augy Studios" Version="$(var.Version)"
           UpgradeCode="7d0c6a52-1e3f-4b8c-9a61-2f4e5b8d9c13" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer uwuBoard is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.Source)\data\flutter_assets\assets\images\tray.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://board.uwuapps.org" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="uwuBoard" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.Source)\**" />
    </ComponentGroup>

    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="5b2f7c1e-8d4a-4e6b-b3f9-0c1d2e3f4a5b">
      <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="uwuBoard" Target="[INSTALLFOLDER]uwuBoard.exe" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="Desktop" Directory="DesktopFolder" Name="uwuBoard" Target="[INSTALLFOLDER]uwuBoard.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu" Value="URL:UwU Apps link" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu" Name="URL Protocol" Value="" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu\shell\open\command" Value="&quot;[INSTALLFOLDER]uwuBoard.exe&quot; &quot;%1&quot;" Type="string" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
