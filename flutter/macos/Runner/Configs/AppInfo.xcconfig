// Application-level settings for the Runner target.

// The app's name: the .app's name, the menu bar's, and the window's title. Keep it forever: the
// updater, login item and links point at uwuBoard.app.
PRODUCT_NAME = uwuBoard

// The same id as the Android app's.
PRODUCT_BUNDLE_IDENTIFIER = org.uwuapps.board

