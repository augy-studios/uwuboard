# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The signing key and its passwords: never in git. Back them up somewhere safe; an APK signed
# with a different key can't update one already installed.
android.keystore
*.keystore
*.jks
*.p12
*.pfx
keystore.properties

# Firebase's settings for the app (FIREBASE-SETUP.md): not secret, but your project's own.
google-services.json
*firebase-adminsdk*.json

# Built apps, and the symbols that read obfuscated crashes back. The release ones are copied to
# release/<version>/ at the project root (release/README.md).
*.apk
*.aab
*.idsig
/symbols/

# The Playwright suite's packages and what it leaves behind (e2e/README.md).
/e2e/node_modules/
/e2e/test-results/
/e2e/playwright-report/
