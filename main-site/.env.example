# uwuBoard's environment variables. Set them in the Vercel project (Settings → Environment
# Variables), or copy this file to .env.local for `vercel dev`. Never commit the real values.

# The Supabase project's URL: Project Settings → API → Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service role key: Project Settings → API → service_role. It bypasses Row Level Security,
# so it's only ever used by the API on the server and must never reach the browser.
SUPABASE_SERVICE_KEY=your-service-role-key

# Notifications of new Android app versions (flutter/FIREBASE-SETUP.md). Optional: without them
# the site works, and the app still finds new versions itself while it's open.
#
# The Firebase service account's JSON key (the whole file, or base64 of it), with only the
# "Firebase Cloud Messaging API Admin" role.
FIREBASE_SERVICE_ACCOUNT=
# The secret GitHub signs its release webhook with: a long random string, also in GitHub.
GITHUB_WEBHOOK_SECRET=
# Optional: a read-only GitHub token, raising GitHub's limit on release lookups.
GITHUB_TOKEN=

# ---- Report a bug (/api/bug-report, js/bug-report.js, the apps' Report a bug) ----
# The edge tray's Report a bug sends what went wrong as a Telegram message from a bot to one or
# more chats. The bot's token from BotFather (a bot of its own is easiest), and the chats to send
# to, split by commas: a person's chat ID (after they've sent the bot /start), a group's or
# channel's ID (-100…, the bot added to it), a public one's @name, or <chat ID>/<topic ID> for one
# topic of a group with topics. e.g. 424242,-1001234567890,-1001234567890/17
# BUG-REPORT-SETUP.md, at the top of the repo, goes through making the bot and finding each ID.
# Server-only. Without both, the form says reports can't be sent yet and offers email instead.
BUG_REPORT_BOT_TOKEN=
BUG_REPORT_CHAT_ID=
# Optional: Vercel KV or Upstash Redis, for limits that hold across instances (6 reports an hour
# from one IP, 60 from everyone). Without it, only 2 a minute from one IP, per instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=
